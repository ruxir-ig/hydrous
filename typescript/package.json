{
  "name": "hydrous-ts",
  "version": "0.1.0",
  "description": "TypeScript SDK for Hydrous — bi-temporal memory API over the hydrous HTTP server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["memory", "agent", "llm", "bi-temporal", "rag", "hydradb"],
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=18" }
}
