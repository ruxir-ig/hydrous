# --- LLM provider: openai | openrouter | custom | mock ---
LLM_PROVIDER=openai

# Keys (only the one matching your provider is required)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=                 # generic key for LLM_PROVIDER=custom

# Endpoint / model overrides
LLM_BASE_URL=                # e.g. https://openrouter.ai/api/v1 or your own gateway
LLM_MODEL=gpt-4o-mini        # worker model (extraction, query analysis, gates, reader)
JUDGE_MODEL=gpt-4o-2024-08-06

# --- Embeddings ---
# auto = sentence-transformers if importable, else pure-numpy TF-IDF fallback
EMBEDDING_BACKEND=auto       # auto | sentence-transformers | tfidf
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- HydraDB cloud adapter (optional; integration tests skipped without it) ---
HYDRA_DB_API_KEY=

# --- Paths / tuning ---
DATA_DIR=data
STORE_PATH=data/hydrous.sqlite3
CACHE_DIR=cache
MAX_CONCURRENCY=8
TOP_K=12
QUALITY_MIN_SCORE=0.4   # extraction quality gate: drop facts below this confidence
LOG_LEVEL=INFO
